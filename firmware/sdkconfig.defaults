# Tested compatibility target: ESP-IDF v5.5.x / ESP32-S3.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_OFFSET=0xa000

# Console on UART0 (the board's "UART"/"COM" USB connector) at 921600 baud.
# Keep CSI output below UART capacity: ~35 KB/s of the ~92 KB/s available.
# For boards with only the native USB connector, also apply
# sdkconfig.usb-console (tools/build-flash.ps1 -Console usb).
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
# Mirroring every CSI row to the USB-JTAG port can stall when nothing reads it.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Wi-Fi / CSI (same as Espressif's csi_recv_router defaults)
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=128
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
